{
    "name": "com.balisantih.wariga",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "android": "react-native run-android",
        "android:development": "cross-env ENVFILE=.env.development react-native run-android",
        "android:staging": "cross-env ENVFILE=.env.staging react-native run-android",
        "android:production": "cross-env ENVFILE=.env.production react-native run-android --mode release",
        "build:android:debug": "cd android && cross-env ENVFILE=.env.development gradlew.bat assembleDebug",
        "clean:android": "cd android && gradlew.bat clean",
        "lint:android:release": "cd android && cross-env ENVFILE=.env.production gradlew.bat lintRelease",
        "test:android:release": "cd android && cross-env ENVFILE=.env.production gradlew.bat testReleaseUnitTest",
        "bundle:android:release": "cd android && cross-env ENVFILE=.env.production gradlew.bat bundleRelease",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "ios": "react-native run-ios",
        "lint": "eslint .",
        "start": "react-native start",
        "test": "jest",
        "test:ci": "jest --runInBand --detectOpenHandles",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@notifee/react-native": "^9.1.8",
        "@react-native-async-storage/async-storage": "^3.1.1",
        "@react-native-community/datetimepicker": "^8.6.0",
        "@react-native-community/netinfo": "^12.0.1",
        "@react-native/new-app-screen": "0.86.2",
        "@react-navigation/bottom-tabs": "^7.18.14",
        "@react-navigation/native": "^7.3.14",
        "@react-navigation/native-stack": "^7.18.6",
        "@tanstack/react-query": "^5.101.4",
        "axios": "^1.18.1",
        "date-fns": "^4.4.0",
        "react": "19.2.3",
        "react-hook-form": "^7.83.0",
        "react-native": "0.86.2",
        "react-native-config": "^1.6.1",
        "react-native-keychain": "^10.0.0",
        "react-native-safe-area-context": "^5.8.0",
        "react-native-screens": "^4.26.2",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@babel/preset-env": "^7.25.3",
        "@babel/runtime": "^7.25.0",
        "@react-native-community/cli": "20.2.0",
        "@react-native-community/cli-platform-android": "20.2.0",
        "@react-native-community/cli-platform-ios": "20.2.0",
        "@react-native/babel-preset": "0.86.2",
        "@react-native/eslint-config": "0.86.2",
        "@react-native/jest-preset": "0.86.2",
        "@react-native/metro-config": "0.86.2",
        "@react-native/typescript-config": "0.86.2",
        "@types/jest": "^29.5.13",
        "@types/react": "^19.2.0",
        "@types/react-test-renderer": "^19.1.0",
        "babel-plugin-module-resolver": "^5.0.3",
        "cross-env": "^10.1.0",
        "eslint": "^8.19.0",
        "eslint-plugin-import": "^2.32.0",
        "jest": "^29.6.3",
        "prettier": "2.8.8",
        "react-test-renderer": "19.2.3",
        "typescript": "^5.8.3"
    },
    "engines": {
        "node": ">= 22.11.0"
    }
}
